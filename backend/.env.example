# TrainPulse Backend Environment Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Upstream Live RailRadar API Configuration
# Never expose or commit live API keys.
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in

# Server-Side Cache Configuration
CACHE_TTL_SECONDS=25
