# TrainPulse Frontend Environment Configuration (Optional)
# In development, the app dynamically discovers your local development machine IP for Expo Go or defaults to http://localhost:3000

# Backend API URL override (optional)
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional custom Carto / OpenStreetMap tile key (leave empty for public open tiles)
# EXPO_PUBLIC_CARTO_API_KEY=

